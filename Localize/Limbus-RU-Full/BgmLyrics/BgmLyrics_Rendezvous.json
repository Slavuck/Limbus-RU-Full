    {
      "id": 0,
      "content": "Если ты говоришь,"
    },
    {
      "id": 1,
      "content": "Что жизнь дана лишь затем, чтобы тратить, тратить её впустую,"
    },
    {
      "id": 2,
      "content": "Почему же ты так отчаянно"
    },
    {
      "id": 3,
      "content": "Продолжаешь этот жаркий, жаркий спор?"
    },
    {
      "id": 4,
      "content": "Если, чтобы держаться на плаву,"
    },
    {
      "id": 5,
      "content": "Можно лишь плыть, лишь плыть по течению,"
    },
    {
      "id": 6,
      "content": "Почему же ты так отчаянно пытаешься всё контролировать?"
    },
    {
      "id": 7,
      "content": "Цепи скрыты под изысканной одеждой."
    },
    {
      "id": 8,
      "content": "Снова и снова я вздыхал,"
    },
    {
      "id": 9,
      "content": "Снова и снова я молчал,"
    },
    {
      "id": 10,
      "content": "Снова и снова закрывал глаза"
    },
    {
      "id": 11,
      "content": "От тошнотворного света."
    },
    {
      "id": 12,
      "content": "Снова и снова я взбирался,"
    },
    {
      "id": 13,
      "content": "Снова и снова падал вниз,"
    },
    {
      "id": 14,
      "content": "Снова и снова не слушал"
    },
    {
      "id": 15,
      "content": "Голосов внутри."
    },
    {
      "id": 16,
      "content": "Лестница ускользает, тает,"
    },
    {
      "id": 17,
      "content": "А ты улыбаешься и машешь мне из лифта."
    },
    {
      "id": 18,
      "content": "Если ты говоришь,"
    },
    {
      "id": 19,
      "content": "Если мы — лишь плоды случайной, случайной судьбы,"
    },
    {
      "id": 20,
      "content": "Почему же я всегда"
    },
    {
      "id": 21,
      "content": "Замечаю твой силуэт, твой силуэт?"
    },
    {
      "id": 22,
      "content": "Если, чтобы остаться на плаву,"
    },
    {
      "id": 23,
      "content": "Можно лишь плыть, лишь плыть по течению,"
    },
    {
      "id": 24,
      "content": "Почему же мы всегда"
    },
    {
      "id": 25,
      "content": "В конце концов возвращаемся сюда?"
    },
    {
      "id": 26,
      "content": "Внезапное рандеву."
    },
    {
      "id": 27,
      "content": "Я вдыхаю аромат на твоей шее,"
    },
    {
      "id": 28,
      "content": "А ты оставляешь царапины на моей спине."
    },
    {
      "id": 29,
      "content": "Ещё раз."
    },
    {
      "id": 30,
      "content": "Снова и снова я вздыхал,"
    },
    {
      "id": 31,
      "content": "Снова и снова я молчал,"
    },
    {
      "id": 32,
      "content": "Снова и снова закрывал глаза"
    },
    {
      "id": 33,
      "content": "От тошнотворного света."
    },
    {
      "id": 34,
      "content": "Снова и снова я взбирался,"
    },
    {
      "id": 35,
      "content": "Снова и снова падал вниз,"
    },
    {
      "id": 36,
      "content": "Снова и снова узнавал,"
    },
    {
      "id": 37,
      "content": "Что окровавленные костяшки приносят мне утешение."
    },
    {
      "id": 38,
      "content": "Даже со всей этой обидой и злостью"
    },
    {
      "id": 39,
      "content": "Это всё же гораздо лучше, чем не чувствовать ничего."
    },
    {
      "id": 40,
      "content": "Снова и снова меня ранили,"
    },
    {
      "id": 41,
      "content": "Снова и снова я злился,"
    },
    {
      "id": 42,
      "content": "Снова и снова тянулся"
    },
    {
      "id": 43,
      "content": "К манящему свету."
    },
    {
      "id": 44,
      "content": "Снова и снова я думал,"
    },
    {
      "id": 45,
      "content": "Снова и снова осознавал,"
    },
    {
      "id": 46,
      "content": "Что всё больше становлюсь собой."
