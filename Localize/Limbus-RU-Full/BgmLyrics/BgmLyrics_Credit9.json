{
  "dataList": [
    {
      "id": "0",
      "content": "Гонки за тенями былых дней,"
    },
    {
      "id": "1",
      "content": "Остались лишь тщетные воспоминания."
    },
    {
      "id": "2",
      "content": "Как огонь, охватив меня,"
    },
    {
      "id": "3",
      "content": "Оставил лишь прах в моих руках."
    },
    {
      "id": "4",
      "content": "И пробежав без отдыха,"
    },
    {
      "id": "5",
      "content": "От времён, что душили меня."
    },
    {
      "id": "6",
      "content": "Буду ли скучать даже по этому?"
    },
    {
      "id": "7",
      "content": "Предстоит долгий, долгий путь,"
    },
    {
      "id": "8",
      "content": "Но на прошлое взглянув,"
    },
    {
      "id": "9",
      "content": "Улыбнусь, надеюсь я."
    },
    {
      "id": "10",
      "content": "Лалала, лалалала, лалалалала, ла ла"
    },
    {
      "id": "11",
      "content": "Лалала, лалалала, лалалалала, ла ла"
    },
    {
      "id": "12",
      "content": "Не знаю, сколько жить ещё мне лет,"
    },
    {
      "id": "13",
      "content": "Теперь пора двигаться вперёд."
    },
    {
      "id": "14",
      "content": "И вновь в пути, буду жечь себя дотла,"
    },
    {
      "id": "15",
      "content": "Словно во мне горит свеча."
    },
    {
      "id": "16",
      "content": "Без возможности вздохнуть,"
    },
    {
      "id": "17",
      "content": "В днях, куда меня вытолкнули и швырнули."
    },
    {
      "id": "18",
      "content": "Верю, что найду свою тропу."
    },
    {
      "id": "19",
      "content": "Когда-нибудь в далёком будущем,"
    },
    {
      "id": "20",
      "content": "Но на дни минувшие взглянув,"
    },
    {
      "id": "21",
      "content": "Надеюсь, что смогу улыбнуться."
    },
    {
      "id": "22",
      "content": "Далеко, далеко хочу улететь,"
    },
    {
      "id": "23",
      "content": "Птицей взмыть и коснуться звёзд в небе ночном."
    },
    {
      "id": "24",
      "content": "И вновь, и вновь, встречу я эту ночь, но, ах..."
    },
    {
      "id": "25",
      "content": "Ничего, всё переживём."
    },
    {
      "id": "26",
      "content": "Всё в порядке."
    },
    {
      "id": "27",
      "content": "Д.Б.Т, ведь В.П."
    }
  ]
}
