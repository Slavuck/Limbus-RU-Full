{
  "dataList": [
    {
      "id": 0,
      "content": "В юности потеряна была я"
    },
    {
      "id": 1,
      "content": "Внезапно ты пришла и отперла мою крепко запертую дверь"
    },
    {
      "id": 2,
      "content": "Словно нити, лепестки распустятся"
    },
    {
      "id": 3,
      "content": "Красной гвоздикой пышной"
    },
    {
      "id": 4,
      "content": "Показала мне, что способна я заботиться о ком-то ещё"
    },
    {
      "id": 5,
      "content": "Что во мне всё та же невиновность теплится"
    },
    {
      "id": 6,
      "content": "Ведь теперь я знаю"
    },
    {
      "id": 7,
      "content": "Боль не определяет прошлое"
    },
    {
      "id": 8,
      "content": "Мы созданы, чтоб преодолеть беды бесконечные"
    },
    {
      "id": 9,
      "content": "Знаешь? Потому что ты была рядом"
    },
    {
      "id": 10,
      "content": "Это оказалось не так уж тяжело"
    },
    {
      "id": 11,
      "content": "Буду дорожить каждым мгновением"
    },
    {
      "id": 12,
      "content": "Ведь «С» — не значит «Сайонара»"
    },
    {
      "id": 13,
      "content": "Давай отмотаем наши воспоминания"
    },
    {
      "id": 14,
      "content": "Я знала, что должна сделать шаг"
    },
    {
      "id": 15,
      "content": "Потому что я хотела дать тебе весь мир и даже больше"
    },
    {
      "id": 16,
      "content": "Но правда в том, что ты бы предпочла"
    },
    {
      "id": 17,
      "content": "Провести наше недолгое время вместе"
    },
    {
      "id": 18,
      "content": "Одной защиты оказалось недостаточно"
    },
    {
      "id": 19,
      "content": "Одними подношениями не наполнить пустую чашу, жаждущую любви"
    },
    {
      "id": 20,
      "content": "Снова и снова спрашивала я себя —"
    },
    {
      "id": 21,
      "content": "Что знаю я про любовь?"
    },
    {
      "id": 22,
      "content": "Как я могу отдать то, чего никогда не имела?"
    },
    {
      "id": 23,
      "content": "Знаю лишь одно: я должна и дальше помогать тебе цвести"
    },
    {
      "id": 24,
      "content": "Если тебе не хватает питания"
    },
    {
      "id": 25,
      "content": "Я полью тебя каждой каплей крови своей"
    },
    {
      "id": 26,
      "content": "Но теперь знаю я"
    },
    {
      "id": 27,
      "content": "Жертва — это лёгкий путь"
    },
    {
      "id": 28,
      "content": "Моё отсутствие не изменит факта"
    },
    {
      "id": 29,
      "content": "Что я хотела лучшего для тебя, поверь мне"
    },
    {
      "id": 30,
      "content": "Наши красные нити никогда не разорвутся"
    },
    {
      "id": 31,
      "content": "И «С» — не значит «Сайонара»"
    },
    {
      "id": 32,
      "content": "Простишь ли ты меня наконец?"
    }
  ]
}
