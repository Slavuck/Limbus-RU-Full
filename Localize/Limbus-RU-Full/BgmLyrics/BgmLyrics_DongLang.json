{
  "dataList": [
    {
      "id": 0,
      "content": "Встань на крыло,"
    },
    {
      "id": 1,
      "content": "Знаю, что вы всё ж со мной"
    },
    {
      "id": 2,
      "content": "Ведь толчка для взлёта точно хватит."
    },
    {
      "id": 3,
      "content": "Встань на крыло,"
    },
    {
      "id": 4,
      "content": "И к свободе же взлетим"
    },
    {
      "id": 5,
      "content": "Ближе станет <size=125%><i>идеал</i></size> наш"
    },
    {
      "id": 6,
      "content": "Полным слёз"
    },
    {
      "id": 7,
      "content": "И нежным был;"
    },
    {
      "id": 8,
      "content": "Я видел как душою ты гнил"
    },
    {
      "id": 9,
      "content": "И в зеркале"
    },
    {
      "id": 10,
      "content": "Я помню надежды свет,"
    },
    {
      "id": 11,
      "content": "М-м-м, м-м м-м-м"
    },
    {
      "id": 12,
      "content": "Делал то, что так любил"
    },
    {
      "id": 13,
      "content": "Мало ль этого? Мало ль этого?"
    },
    {
      "id": 14,
      "content": "Ты гений и делаешь всё идеально"
    },
    {
      "id": 15,
      "content": "Мало ль этого? Мало ль этого?"
    },
    {
      "id": 16,
      "content": "Опять и опять"
    },
    {
      "id": 17,
      "content": "Ты запер меня, я запер себя,"
    },
    {
      "id": 18,
      "content": "Мы пригвоздили меня к земле."
    },
    {
      "id": 19,
      "content": "Почва дарила мне тепло."
    },
    {
      "id": 20,
      "content": "Умрите, маленькие мечты"
    },
    {
      "id": 21,
      "content": "И убейте камелию, цветущую во мне"
    },
    {
      "id": 22,
      "content": "Не будет ль мне проще взять и сдаться?"
    },
    {
      "id": 23,
      "content": "Что же я стремлюсь к мечтам, коих не дано?"
    },
    {
      "id": 24,
      "content": "<size=125%><i>Странна</i></size> ли моя жажда нормальности?"
    },
    {
      "id": 25,
      "content": "И целым крылом"
    },
    {
      "id": 26,
      "content": "(Прощай, прощай, прощай)"
    },
    {
      "id": 27,
      "content": "Где же вы скрывались до сих пор?"
    },
    {
      "id": 28,
      "content": "(Прощай, прощай, прощай)"
    },
    {
      "id": 29,
      "content": "Отведи меня к разуму, что привёл нас к началу"
    },
    {
      "id": 30,
      "content": "И, целым крылом"
    },
    {
      "id": 31,
      "content": "(Прощай, прощай, прощай)"
    },
    {
      "id": 32,
      "content": "Давай покажем, кем я могу стать"
    },
    {
      "id": 33,
      "content": "(Прощай, прощай, прощай)"
    },
    {
      "id": 34,
      "content": "Позвольте осмелиться сказать ещё раз, напоследок"
    },
    {
      "id": 35,
      "content": "<size=200%><i>Вот и всё</i></size>"
    }
  ]
}
